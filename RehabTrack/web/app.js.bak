let selectedSession = null;
let selectedExerciseFromSession = null;

let activeExercise = null;
let activeExerciseButton = null;
let exerciseState = "idle";


const exerciseNames = {
    knee_extension: "Knee Extension",
    squat: "Squat"
};


const exerciseTargets = {
    knee_extension: {
        sets: 3,
        repsPerSet: 10
    },
    squat: {
        sets: 3,
        repsPerSet: 10
    }
};


/* --------------------------------------------------
   INITIAL UI SETUP
-------------------------------------------------- */

function setupExerciseUI() {
    let currentTitle =
        document.getElementById("currentExerciseName");

    if (!currentTitle) {
        currentTitle =
            document.querySelector(".session-header h2");

        if (currentTitle) {
            currentTitle.id = "currentExerciseName";
        }
    }


    document.querySelectorAll(".exercise-button").forEach(button => {
        const exercise = button.dataset.exercise;

        button.onclick = () => {
            selectExercise(exercise);
        };

        ensureExerciseProgressElements(button);
    });


    ensureControlButtons();
    ensureResultBox();
}


function ensureExerciseProgressElements(button) {
    const exercise = button.dataset.exercise;
    const card = button.closest(".exercise-card");

    if (!card) {
        return;
    }

    const textArea = card.firstElementChild;

    if (!textArea) {
        return;
    }


    let progress =
        document.getElementById(`progress-${exercise}`);

    if (!progress) {
        progress = document.createElement("p");
        progress.id = `progress-${exercise}`;
        progress.className = "exercise-progress";
        progress.textContent = "Loading progress...";

        textArea.appendChild(progress);
    }


    let status =
        document.getElementById(`status-${exercise}`);

    if (!status) {
        status = document.createElement("span");
        status.id = `status-${exercise}`;
        status.className =
            "exercise-status not-started";
        status.textContent = "○ Not started";

        textArea.appendChild(status);
    }
}


function ensureControlButtons() {
    const title =
        document.getElementById("currentExerciseName");

    if (!title) {
        return;
    }

    const parent = title.parentElement;


    let pauseStopButton =
        document.getElementById("stopExerciseButton");

    if (!pauseStopButton) {
        pauseStopButton = document.createElement("button");
        pauseStopButton.id = "stopExerciseButton";
        pauseStopButton.textContent = "Pause";
        pauseStopButton.style.display = "none";

        parent.appendChild(pauseStopButton);
    }


    let resumeButton =
        document.getElementById("resumeExerciseButton");

    if (!resumeButton) {
        resumeButton = document.createElement("button");
        resumeButton.id = "resumeExerciseButton";
        resumeButton.textContent = "Resume exercise";
        resumeButton.style.display = "none";

        parent.appendChild(resumeButton);
    }


    pauseStopButton.onclick = exerciseControl;
    resumeButton.onclick = resumeExercise;
}


function ensureResultBox() {
    if (document.getElementById("exerciseResult")) {
        return;
    }

    const sessionHeader =
        document.querySelector(".session-header");

    if (!sessionHeader) {
        return;
    }

    const box = document.createElement("section");

    box.id = "exerciseResult";
    box.className = "panel exercise-result";
    box.style.display = "none";

    box.innerHTML = `
        <div class="panel-title">
            <div>
                <span class="label">SESSION COMPLETE</span>
                <h3 id="resultExerciseName">
                    Exercise completed
                </h3>
            </div>
        </div>

        <div class="result-summary">
            <div>
                <span>Set</span>
                <strong id="resultSet">--</strong>
            </div>

            <div>
                <span>Completed</span>
                <strong id="resultReps">--</strong>
            </div>

            <div>
                <span>Remaining</span>
                <strong id="resultRemaining">--</strong>
            </div>
        </div>

        <p id="resultMessage"></p>
    `;

    sessionHeader.parentNode.insertBefore(
        box,
        sessionHeader
    );
}



function exerciseFromFilename(filename) {
    if (!filename) {
        return null;
    }

    if (filename.startsWith("knee_extension_")) {
        return "knee_extension";
    }

    if (filename.startsWith("squat_")) {
        return "squat";
    }

    return null;
}


function updateContinueButton() {
    const button =
        document.getElementById("continueExerciseButton");

    if (!button) {
        return;
    }

    if (
        selectedExerciseFromSession &&
        exerciseState === "idle"
    ) {
        button.style.display = "inline-block";

        button.onclick = () => {
            const exercise = selectedExerciseFromSession;

            selectedSession = null;
            selectedExerciseFromSession = null;

            button.style.display = "none";

            selectExercise(exercise);
        };
    } else {
        button.style.display = "none";
    }
}


/* --------------------------------------------------
   SESSION DATA
-------------------------------------------------- */

async function loadSession(filename = selectedSession) {
    try {
        let url = "/api/session";

        if (filename) {
            url += "?file=" + encodeURIComponent(filename);
        }

        const response = await fetch(url);
        const data = await response.json();

        if (!response.ok) {
            console.warn("Session:", data.error);
            return;
        }

        const fileExercise =
            exerciseFromFilename(data.file);

        if (fileExercise && exerciseState === "idle") {
            selectedExerciseFromSession = fileExercise;

            setText(
                "currentExerciseName",
                exerciseNames[fileExercise]
            );

            await updateCurrentExerciseProgress(fileExercise);

            updateContinueButton();
        }


        const filenameElement =
            document.getElementById("filename");

        if (filenameElement) {
            filenameElement.textContent = data.file;
        }


        const updatedElement =
            document.getElementById("lastUpdated");

        if (updatedElement) {
            updatedElement.textContent =
                "Last updated: " +
                new Date().toLocaleTimeString();
        }


        setText("repetitions", data.repetitions);
        setText("rom", data.average_rom);
        setText("speed", data.average_speed);
        setText("cadence", data.cadence);

        setText(
            "axis",
            `Gyroscope axis: ${data.gyro_axis}`
        );


        const table =
            document.getElementById("repTable");

        if (table) {
            table.innerHTML = "";

            data.rep_details.forEach(rep => {
                const row =
                    document.createElement("tr");

                row.innerHTML = `
                    <td>${rep.rep}</td>
                    <td>${rep.rom}°</td>
                    <td>${rep.speed}°/s</td>
                `;

                table.appendChild(row);
            });
        }


        drawGraph(data.graph);

    } catch (error) {
        console.error("Session error:", error);
    }
}


function setText(id, value) {
    const element = document.getElementById(id);

    if (element) {
        element.textContent = value;
    }
}


/* --------------------------------------------------
   GRAPH
-------------------------------------------------- */

function drawGraph(points) {
    const canvas =
        document.getElementById("angleChart");

    if (!canvas || !points || points.length === 0) {
        return;
    }

    const ctx = canvas.getContext("2d");

    const width = canvas.clientWidth;
    const height = canvas.clientHeight || 320;

    const scale =
        window.devicePixelRatio || 1;

    canvas.width = width * scale;
    canvas.height = height * scale;

    ctx.scale(scale, scale);

    const padding = 45;

    const times =
        points.map(point => point.time);

    const angles =
        points.map(point => point.angle);

    const minX = Math.min(...times);
    const maxX = Math.max(...times);

    let minY = Math.min(...angles);
    let maxY = Math.max(...angles);

    if (minY === maxY) {
        minY -= 1;
        maxY += 1;
    }


    const mapX = x =>
        padding +
        ((x - minX) / (maxX - minX || 1)) *
        (width - padding * 2);


    const mapY = y =>
        height -
        padding -
        ((y - minY) / (maxY - minY || 1)) *
        (height - padding * 2);


    ctx.clearRect(0, 0, width, height);


    ctx.strokeStyle = "#dce4e0";
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.moveTo(padding, padding);
    ctx.lineTo(padding, height - padding);
    ctx.lineTo(width - padding, height - padding);
    ctx.stroke();


    ctx.fillStyle = "#718078";
    ctx.font = "12px sans-serif";

    ctx.fillText(
        `${maxY.toFixed(0)}°`,
        5,
        padding + 5
    );

    ctx.fillText(
        `${minY.toFixed(0)}°`,
        5,
        height - padding
    );

    ctx.fillText(
        `${maxX.toFixed(1)} s`,
        width - padding - 35,
        height - 15
    );


    ctx.strokeStyle = "#287a56";
    ctx.lineWidth = 2.5;

    ctx.beginPath();

    points.forEach((point, index) => {
        const x = mapX(point.time);
        const y = mapY(point.angle);

        if (index === 0) {
            ctx.moveTo(x, y);
        } else {
            ctx.lineTo(x, y);
        }
    });

    ctx.stroke();
}


/* --------------------------------------------------
   SENSOR STATUS
-------------------------------------------------- */

async function loadStatus() {
    try {
        const response =
            await fetch("/api/status");

        const data =
            await response.json();


        const live =
            document.getElementById("liveDataStatus");

        if (live) {
            live.textContent =
                data.receiving
                    ? "Live data: receiving"
                    : "Live data: stopped";
        }


        const status =
            document.querySelector(".status");

        if (!status) {
            return;
        }


        if (data.connected && data.recording) {

            status.innerHTML =
                '<span class="status-dot"></span> Sensor connected · Recording';

            status.querySelector(".status-dot")
                .style.background = "#36a269";

        } else if (data.connected) {

            status.innerHTML =
                '<span class="status-dot"></span> Sensor connected';

            status.querySelector(".status-dot")
                .style.background = "#e6a23c";

        } else {

            status.innerHTML =
                '<span class="status-dot"></span> Sensor disconnected';

            status.querySelector(".status-dot")
                .style.background = "#c94c4c";
        }

    } catch (error) {
        console.error("Status error:", error);
    }
}


/* --------------------------------------------------
   SESSION HISTORY
-------------------------------------------------- */


async function loadSessions() {
    try {
        const response = await fetch("/api/sessions");
        const sessions = await response.json();

        const container =
            document.getElementById("sessionList");

        if (!container || !Array.isArray(sessions)) {
            return;
        }

        container.innerHTML = "";


        sessions.forEach(session => {
            const item =
                document.createElement("div");

            item.className = "session-history-card";

            if (selectedSession === session.file) {
                item.classList.add("selected-session");
            }


            const repsText =
                session.repetitions === null
                    ? "No result"
                    : `${session.repetitions} repetitions`;


            const date = new Date(
                session.modified.replace(" ", "T")
            );

            const dateText =
                Number.isNaN(date.getTime())
                    ? session.modified
                    : date.toLocaleString([], {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                        hour: "2-digit",
                        minute: "2-digit"
                    });


            const canContinue =
                session.exercise === "knee_extension" ||
                session.exercise === "squat";


            item.innerHTML = `
                <div class="session-history-info">

                    <strong class="session-exercise-name">
                        ${session.exercise_name}
                    </strong>

                    <div class="session-history-date">
                        ${dateText}
                    </div>

                    <div class="session-history-reps">
                        ${repsText}
                    </div>

                </div>

                <div class="session-history-actions">

                    <button class="session-view-button">
                        View session
                    </button>

                    ${
                        canContinue
                            ? `
                            <button class="session-continue-button">
                                Continue exercise
                            </button>
                            `
                            : ""
                    }

                </div>
            `;


            const viewButton =
                item.querySelector(".session-view-button");

            viewButton.addEventListener(
                "click",
                async () => {

                    selectedSession = session.file;

                    const resultBox =
                        document.getElementById(
                            "exerciseResult"
                        );

                    if (resultBox) {
                        resultBox.style.display = "none";
                    }

                    await loadSession(
                        selectedSession
                    );

                    await loadSessions();

                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });
                }
            );


            const continueButton =
                item.querySelector(
                    ".session-continue-button"
                );

            if (continueButton) {

                continueButton.addEventListener(
                    "click",
                    async () => {

                        selectedSession = null;

                        setText(
                            "currentExerciseName",
                            exerciseNames[
                                session.exercise
                            ]
                        );

                        await selectExercise(
                            session.exercise
                        );

                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    }
                );
            }


            container.appendChild(item);
        });

    } catch (error) {
        console.error(
            "Session history error:",
            error
        );
    }
}


/* --------------------------------------------------
   PATIENT PROGRESS
-------------------------------------------------- */

async function loadExerciseProgress() {
    try {
        const response =
            await fetch("/api/progress");

        const progress =
            await response.json();

        if (!response.ok) {
            throw new Error(
                "Could not load progress."
            );
        }


        Object.keys(exerciseTargets)
            .forEach(exercise => {

                const target =
                    exerciseTargets[exercise];

                const current =
                    progress[exercise];

                if (!current) {
                    return;
                }


                const progressElement =
                    document.getElementById(
                        `progress-${exercise}`
                    );

                const statusElement =
                    document.getElementById(
                        `status-${exercise}`
                    );


                if (progressElement) {

                    if (
                        current.completed_sets
                        >= target.sets
                    ) {
                        progressElement.textContent =
                            `${target.sets}/${target.sets} sets completed`;
                    } else {

                        const setNumber =
                            current.completed_sets + 1;

                        progressElement.textContent =
                            `Set ${setNumber} of ${target.sets} · ` +
                            `${current.reps_in_set}/${target.repsPerSet} reps`;
                    }
                }


                if (statusElement) {

                    statusElement.className =
                        "exercise-status";


                    if (
                        current.completed_sets
                        >= target.sets
                    ) {

                        statusElement.textContent =
                            "✓ Completed";

                        statusElement.classList.add(
                            "completed"
                        );

                    } else if (
                        current.completed_sets > 0 ||
                        current.reps_in_set > 0
                    ) {

                        statusElement.textContent =
                            "● In progress";

                        statusElement.classList.add(
                            "in-progress"
                        );

                    } else {

                        statusElement.textContent =
                            "○ Not started";

                        statusElement.classList.add(
                            "not-started"
                        );
                    }
                }
            });

    } catch (error) {
        console.error(
            "Progress load error:",
            error
        );
    }
}


/* --------------------------------------------------
   START EXERCISE
-------------------------------------------------- */


async function updateCurrentExerciseProgress(exercise) {
    try {
        const response = await fetch("/api/progress");
        const progress = await response.json();

        const current = progress[exercise];
        const target = exerciseTargets[exercise];

        if (!current || !target) {
            return;
        }

        let element =
            document.getElementById("currentExerciseProgress");

        if (!element) {
            element = document.createElement("div");
            element.id = "currentExerciseProgress";
            element.className = "current-exercise-progress";

            const title =
                document.getElementById("currentExerciseName");

            if (title) {
                title.insertAdjacentElement(
                    "afterend",
                    element
                );
            }
        }

        if (current.completed_sets >= target.sets) {
            element.textContent =
                `Completed · ${target.sets}/${target.sets} sets`;
        } else {
            const setNumber =
                current.completed_sets + 1;

            element.textContent =
                `Set ${setNumber} of ${target.sets} · ` +
                `${current.reps_in_set}/${target.repsPerSet} reps`;
        }

    } catch (error) {
        console.error(
            "Current exercise progress error:",
            error
        );
    }
}


async function selectExercise(exercise) {
    if (exerciseState !== "idle") {
        return;
    }

    const button =
        document.querySelector(
            `.exercise-button[data-exercise="${exercise}"]`
        );

    if (!button) {
        return;
    }


    const resultBox =
        document.getElementById("exerciseResult");

    if (resultBox) {
        resultBox.style.display = "none";
    }


    setText(
        "currentExerciseName",
        exerciseNames[exercise]
    );

    await updateCurrentExerciseProgress(exercise);


    button.disabled = true;
    button.textContent = "Starting...";


    document
        .querySelectorAll(".exercise-button")
        .forEach(otherButton => {

            if (otherButton !== button) {
                otherButton.disabled = true;
            }
        });


    try {
        const response =
            await fetch(
                "/api/start-exercise",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        exercise: exercise
                    })
                }
            );


        const data =
            await response.json();


        if (!response.ok) {
            throw new Error(
                data.error ||
                "Could not start exercise."
            );
        }


        activeExercise = exercise;
        activeExerciseButton = button;
        exerciseState = "recording";

        selectedSession = null;


        button.textContent = "Recording...";
        button.classList.add("is-recording");


        const card =
            button.closest(".exercise-card");

        if (card) {
            card.classList.add("is-active");
        }


        const pauseButton =
            document.getElementById(
                "stopExerciseButton"
            );

        pauseButton.style.display =
            "inline-block";

        pauseButton.style.background =
            "#e6a23c";

        pauseButton.textContent =
            "Pause";

        pauseButton.disabled =
            false;


        const resumeButton =
            document.getElementById(
                "resumeExerciseButton"
            );

        resumeButton.style.display =
            "none";


        loadStatus();

    } catch (error) {

        console.error(error);

        resetExerciseControls();

        alert(
            "Could not start exercise: " +
            error.message
        );
    }
}


/* --------------------------------------------------
   PAUSE / STOP
-------------------------------------------------- */

async function exerciseControl() {
    const controlButton =
        document.getElementById(
            "stopExerciseButton"
        );

    const resumeButton =
        document.getElementById(
            "resumeExerciseButton"
        );


    /* RECORDING -> PAUSE */

    if (exerciseState === "recording") {

        controlButton.disabled = true;
        controlButton.textContent =
            "Pausing...";


        try {
            const response =
                await fetch(
                    "/api/pause-exercise",
                    {
                        method: "POST"
                    }
                );

            const data =
                await response.json();


            if (!response.ok) {
                throw new Error(
                    data.error ||
                    "Could not pause exercise."
                );
            }


            exerciseState = "paused";


            if (activeExerciseButton) {
                activeExerciseButton
                    .classList.remove(
                        "is-recording"
                    );

                activeExerciseButton
                    .classList.add(
                        "is-paused"
                    );

                activeExerciseButton
                    .textContent =
                        "Paused";
            }


            controlButton.disabled = false;
            controlButton.textContent =
                "Stop exercise";

            controlButton.style.background =
                "#c94c4c";


            resumeButton.style.display =
                "inline-block";

            resumeButton.disabled = false;

            resumeButton.textContent =
                "Resume exercise";


            loadStatus();

        } catch (error) {

            console.error(error);

            controlButton.disabled = false;
            controlButton.textContent =
                "Pause";

            alert(
                "Could not pause exercise: " +
                error.message
            );
        }

        return;
    }


    /* PAUSED -> STOP */

    if (exerciseState === "paused") {

        const finishedExercise =
            activeExercise;


        controlButton.disabled = true;
        controlButton.textContent =
            "Stopping...";

        resumeButton.disabled = true;


        try {
            const response =
                await fetch(
                    "/api/stop-exercise",
                    {
                        method: "POST"
                    }
                );

            const data =
                await response.json();


            if (!response.ok) {
                throw new Error(
                    data.error ||
                    "Could not stop exercise."
                );
            }


            resetExerciseControls();

            selectedSession = null;


            setTimeout(
                async () => {

                    await loadSession();
                    await loadSessions();
                    await loadStatus();

                    await showExerciseResult(
                        finishedExercise
                    );

                    await loadExerciseProgress();

                },
                1000
            );

        } catch (error) {

            console.error(error);

            controlButton.disabled = false;

            controlButton.textContent =
                "Stop exercise";

            resumeButton.disabled = false;

            alert(
                "Could not stop exercise: " +
                error.message
            );
        }
    }
}


/* --------------------------------------------------
   RESUME
-------------------------------------------------- */

async function resumeExercise() {
    if (exerciseState !== "paused") {
        return;
    }

    const resumeButton =
        document.getElementById(
            "resumeExerciseButton"
        );

    const pauseButton =
        document.getElementById(
            "stopExerciseButton"
        );


    resumeButton.disabled = true;
    resumeButton.textContent =
        "Resuming...";


    try {
        const response =
            await fetch(
                "/api/resume-exercise",
                {
                    method: "POST"
                }
            );

        const data =
            await response.json();


        if (!response.ok) {
            throw new Error(
                data.error ||
                "Could not resume exercise."
            );
        }


        exerciseState = "recording";


        if (activeExerciseButton) {

            activeExerciseButton
                .classList.remove(
                    "is-paused"
                );

            activeExerciseButton
                .classList.add(
                    "is-recording"
                );

            activeExerciseButton
                .textContent =
                    "Recording...";
        }


        resumeButton.style.display =
            "none";

        resumeButton.disabled =
            false;

        resumeButton.textContent =
            "Resume exercise";


        pauseButton.style.display =
            "inline-block";

        pauseButton.style.background =
            "#e6a23c";

        pauseButton.textContent =
            "Pause";

        pauseButton.disabled =
            false;


        loadStatus();

    } catch (error) {

        console.error(error);

        resumeButton.disabled = false;

        resumeButton.textContent =
            "Resume exercise";

        alert(
            "Could not resume exercise: " +
            error.message
        );
    }
}


/* --------------------------------------------------
   RESET EXERCISE CONTROLS
-------------------------------------------------- */

function resetExerciseControls() {
    activeExercise = null;
    activeExerciseButton = null;
    exerciseState = "idle";


    document
        .querySelectorAll(".exercise-button")
        .forEach(button => {

            button.disabled = false;
            button.textContent =
                "Start exercise";

            button.classList.remove(
                "is-recording"
            );

            button.classList.remove(
                "is-paused"
            );


            const card =
                button.closest(
                    ".exercise-card"
                );

            if (card) {
                card.classList.remove(
                    "is-active"
                );
            }
        });


    const controlButton =
        document.getElementById(
            "stopExerciseButton"
        );

    controlButton.style.display =
        "none";

    controlButton.disabled =
        false;

    controlButton.textContent =
        "Pause";

    controlButton.style.background =
        "#e6a23c";


    const resumeButton =
        document.getElementById(
            "resumeExerciseButton"
        );

    resumeButton.style.display =
        "none";

    resumeButton.disabled =
        false;

    resumeButton.textContent =
        "Resume exercise";
}


/* --------------------------------------------------
   SESSION RESULT + SAVE PROGRESS
-------------------------------------------------- */

async function showExerciseResult(exercise) {
    try {

        const sessionResponse =
            await fetch("/api/session");

        const session =
            await sessionResponse.json();


        if (!sessionResponse.ok) {
            throw new Error(
                session.error ||
                "Could not load session."
            );
        }


        const progressResponse =
            await fetch(
                "/api/progress/update",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        exercise: exercise,
                        repetitions:
                            session.repetitions
                    })
                }
            );


        const progress =
            await progressResponse.json();


        if (!progressResponse.ok) {
            throw new Error(
                progress.error ||
                "Could not save progress."
            );
        }


        setText(
            "resultExerciseName",
            exerciseNames[exercise]
        );


        if (progress.exercise_completed) {

            setText(
                "resultSet",
                `${progress.sets} / ${progress.sets}`
            );

            setText(
                "resultReps",
                `${progress.reps_per_set} / ${progress.reps_per_set}`
            );

            setText(
                "resultRemaining",
                "0"
            );

            setText(
                "resultMessage",
                "Exercise completed. All prescribed sets are finished."
            );

        } else {

            const currentSet =
                progress.completed_sets + 1;

            const remaining =
                Math.max(
                    0,
                    progress.reps_per_set -
                    progress.reps_in_set
                );


            setText(
                "resultSet",
                `${currentSet} / ${progress.sets}`
            );

            setText(
                "resultReps",
                `${progress.reps_in_set} / ${progress.reps_per_set}`
            );

            setText(
                "resultRemaining",
                remaining
            );


            if (
                progress.reps_in_set === 0 &&
                progress.completed_sets > 0
            ) {

                setText(
                    "resultMessage",
                    `Set ${progress.completed_sets} completed. Next: set ${currentSet} of ${progress.sets}.`
                );

            } else {

                setText(
                    "resultMessage",
                    `${remaining} repetitions remaining in set ${currentSet}.`
                );
            }
        }


        const resultBox =
            document.getElementById(
                "exerciseResult"
            );

        resultBox.style.display =
            "block";


        resultBox.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });


        await loadExerciseProgress();

    } catch (error) {

        console.error(
            "Result error:",
            error
        );

        alert(
            "Could not save exercise progress: " +
            error.message
        );
    }
}


/* --------------------------------------------------
   START PAGE
-------------------------------------------------- */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        setupExerciseUI();

        loadSession();
        loadStatus();
        loadSessions();
        loadExerciseProgress();


        setInterval(
            () => loadSession(),
            1000
        );


        setInterval(
            () => loadStatus(),
            1000
        );


        setInterval(
            () => loadSessions(),
            5000
        );


        setInterval(
            () => loadExerciseProgress(),
            3000
        );
    }
);
