<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RehabTrack</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

<div class="page">

    <header>
        <div>
            <h1>RehabTrack</h1>
            <p>Rehabilitation movement monitoring</p>
        </div>

        <div class="status">
            <span class="status-dot"></span>
            Session loaded
        </div>
        <div id="liveDataStatus" class="filename">
            Live data: --
        </div>
    </header>

    <section class="panel">
        <div class="panel-title">
            <div>
                <span class="label">MY EXERCISES</span>
                <h3>Today's rehabilitation</h3>
            </div>
        </div>

        <div class="exercise-grid">

            <div class="exercise-card">
                <div>
                    <span class="label">EXERCISE 1</span>
                    <h3>Knee Extension</h3>
                    <p>3 sets × 10 repetitions</p>
                </div>

                <button class="exercise-button"
                        data-exercise="knee_extension" onclick="selectExercise('knee_extension')">
                    Start exercise
                </button>
            </div>

            <div class="exercise-card">
                <div>
                    <span class="label">EXERCISE 2</span>
                    <h3>Squat</h3>
                    <p>3 sets × 10 repetitions</p>
                </div>

                <button class="exercise-button"
                        data-exercise="squat" onclick="selectExercise('squat')">
                    Start exercise
                </button>
            </div>

        </div>
    </section>



    <section class="session-header">
        <div>
            <span class="label">CURRENT EXERCISE</span>
            <h2 id="currentExerciseName">Knee Extension</h2>

            <button id="continueExerciseButton"
                    style="display:none;">
                Continue exercise
            </button>

            <button id="stopExerciseButton"
                    onclick="exerciseControl()"
                    style="display:none;">
                Pause
            </button>

            <button id="resumeExerciseButton"
                    onclick="resumeExercise()"
                    style="display:none;">
                Resume exercise
            </button>
        </div>

        <div>
            <div id="filename" class="filename">
                Loading...
            </div>

            <div id="lastUpdated" class="filename">
                Last updated: --
            </div>
        </div>
    </section>


    <section class="metrics">

        <div class="card">
            <span>Repetitions</span>
            <strong id="repetitions">--</strong>
            <small>reps</small>
        </div>

        <div class="card">
            <span>Average ROM</span>
            <strong id="rom">--</strong>
            <small>degrees</small>
        </div>

        <div class="card">
            <span>Movement Speed</span>
            <strong id="speed">--</strong>
            <small>°/s</small>
        </div>

        <div class="card">
            <span>Cadence</span>
            <strong id="cadence">--</strong>
            <small>reps/min</small>
        </div>

    </section>


    <section class="panel">
        <div class="panel-title">
            <div>
                <span class="label">MOVEMENT</span>
                <h3>Relative sensor rotation</h3>
            </div>

            <span class="axis" id="axis"></span>
        </div>

        <canvas id="angleChart"></canvas>
    </section>


    <section class="panel">

        <div class="panel-title">
            <div>
                <span class="label">SESSION DETAILS</span>
                <h3>Repetition analysis</h3>
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Rep</th>
                        <th>ROM</th>
                        <th>Peak speed</th>
                    </tr>
                </thead>

                <tbody id="repTable"></tbody>
            </table>
        </div>

    </section>
    
    
    <section id="exerciseResult" class="panel exercise-result" style="display:none;">
        <div class="panel-title">
            <div>
                <span class="label">SESSION COMPLETE</span>
                <h3 id="resultExerciseName">Exercise completed</h3>
            </div>
        </div>

        <div class="result-summary">
            <div>
                <span>Completed</span>
                <strong id="resultReps">-- / 10</strong>
            </div>

            <div>
                <span>Remaining</span>
                <strong id="resultRemaining">--</strong>
            </div>
        </div>

        <p id="resultMessage"></p>
    </section>

<section class="panel">
        <div class="panel-title">
            <div>
                <span class="label">SESSION HISTORY</span>
                <h3>Logged sessions</h3>
            </div>
        </div>

        <div id="sessionList"></div>
    </section>


    <footer>
        RehabTrack prototype · Relative lower-leg/sensor movement
    </footer>

</div>

<script src="/app.js"></script>

</body>
</html>
