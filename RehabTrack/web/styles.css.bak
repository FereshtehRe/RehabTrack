* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f4f7f6;
    color: #17211d;
}

.page {
    max-width: 1200px;
    margin: auto;
    padding: 40px 24px;
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
}

h1 {
    margin: 0;
    font-size: 34px;
}

header p {
    margin: 5px 0 0;
    color: #718078;
}

.status {
    background: white;
    border: 1px solid #dfe6e2;
    padding: 10px 16px;
    border-radius: 30px;
    font-size: 14px;
}

.status-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: #36a269;
    border-radius: 50%;
    margin-right: 7px;
}

.session-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 24px;
}

.session-header h2 {
    margin: 5px 0 0;
    font-size: 26px;
}

.label {
    font-size: 11px;
    letter-spacing: 1.3px;
    color: #7b8982;
    font-weight: 700;
}

.filename {
    color: #718078;
    font-size: 13px;
}

.metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 22px;
}

.card {
    background: white;
    border: 1px solid #e0e7e3;
    border-radius: 16px;
    padding: 24px;
}

.card span {
    display: block;
    font-size: 14px;
    color: #718078;
    margin-bottom: 14px;
}

.card strong {
    display: inline-block;
    font-size: 36px;
    margin-right: 5px;
}

.card small {
    color: #7b8982;
}

.panel {
    background: white;
    border: 1px solid #e0e7e3;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 22px;
}

.panel-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.panel-title h3 {
    margin: 5px 0 0;
    font-size: 20px;
}

.axis {
    font-size: 13px;
    color: #718078;
}

canvas {
    width: 100%;
    height: 300px;
    display: block;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    text-align: left;
    padding: 15px 12px;
    border-bottom: 1px solid #edf1ef;
}

th {
    font-size: 12px;
    color: #718078;
    text-transform: uppercase;
}

td {
    font-size: 15px;
}

footer {
    text-align: center;
    color: #8b9791;
    font-size: 12px;
    padding: 15px;
}

@media (max-width: 800px) {
    .metrics {
        grid-template-columns: repeat(2, 1fr);
    }

    header,
    .session-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 15px;
    }
}

@media (max-width: 500px) {
    .metrics {
        grid-template-columns: 1fr;
    }
}

.exercise-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
}

.exercise-card {
    border: 1px solid #e1e8e4;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    background: white;
}

.exercise-card h3 {
    margin: 6px 0;
}

.exercise-card p {
    margin: 0;
    color: #718078;
}

.exercise-button {
    border: none;
    background: #287a56;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
}

.exercise-button:hover {
    opacity: 0.9;
}

@media (max-width: 700px) {
    .exercise-grid {
        grid-template-columns: 1fr;
    }

    .exercise-card {
        align-items: flex-start;
        flex-direction: column;
    }
}

#stopExerciseButton {
    margin-top: 12px;
    border: none;
    background: #c94c4c;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
}

#stopExerciseButton:hover {
    opacity: 0.9;
}

.exercise-result {
    border-left: 4px solid #287a56;
}

.result-summary {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 16px;
}

.result-summary div {
    background: #f4f7f6;
    padding: 16px;
    border-radius: 10px;
}

.result-summary span {
    display: block;
    color: #718078;
    font-size: 13px;
    margin-bottom: 5px;
}

.result-summary strong {
    font-size: 24px;
}

#resultMessage {
    margin-top: 18px;
    margin-bottom: 0;
}


#resumeExerciseButton {
    margin-top: 12px;
    margin-left: 8px;
    border: none;
    background: #287a56;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
}

#resumeExerciseButton:hover {
    opacity: 0.9;
}


.exercise-card .exercise-progress {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #287a56;
}

.exercise-status {
    display: inline-block;
    margin-top: 10px;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.exercise-status.not-started {
    background: #edf1ef;
    color: #718078;
}

.exercise-status.in-progress {
    background: #fff3d8;
    color: #9a6815;
}

.exercise-status.completed {
    background: #e6f4ed;
    color: #287a56;
}
